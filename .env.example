# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
# DB_TYPE options: 'sqlite' (default), 'postgres', 'mysql'
DB_TYPE=sqlite

# SQLite (local file-based)
SQLITE_STORAGE=./server/data/mini-crm.sqlite

# PostgreSQL / MySQL (remote/local server)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mini_crm
DB_USER=postgres
DB_PASSWORD=password

# Auth
JWT_SECRET=replace_with_a_strong_jwt_secret

# Admin credentials
ADMIN_EMAIL=admin@mini-crm.com
ADMIN_PASSWORD=admin12345
